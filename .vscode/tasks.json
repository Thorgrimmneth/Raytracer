{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rebuild Raytracer",
      "type": "shell",
      "command": "rm -rf build && cmake -S . -B build && cmake --build build -j$(nproc)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": false
      }
    },
    {
      "label": "Profile shadePlasticKernel",
      "type": "shell",
      "command": "ncu -f --set full --kernel-name shadePlasticKernel -o profile ./build/mon_projet && ncu-ui profile.ncu-rep",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": true
      }
    },
    {
      "label": "Fast make",
      "type": "shell",
      "command": "cd build && make && cd .. && ./build/mon_projet -mode 1 -w 1920 -t 0.87 -convergence 1 -rng 3 -rpp 100000 -value 0.001 -printValue 1 -output 1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": true
      }
    }
    
  ]
}