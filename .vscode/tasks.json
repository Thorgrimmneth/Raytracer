{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rebuild Raytracer",
      "type": "shell",
      "command": "rm -rf build && cmake -S . -B build && cmake --build build -j$(nproc)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "close": true
      }
    }
  ]
}